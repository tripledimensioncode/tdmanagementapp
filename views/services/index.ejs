<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Services</h1>
      <p class="text-sm text-slate-500">Manage the fabrication services workers can select when creating a job.</p>
    </div>
    <a href="/" class="text-sm text-blue-600 hover:underline">&larr; Back to Dashboard</a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- List of Services -->
    <div class="md:col-span-2 bg-white rounded-2xl p-5 shadow border border-slate-200">
      <h2 class="text-base font-bold text-slate-800 mb-4">Active Services (<%= services.length %>)</h2>

      <% if (services.length === 0) { %>
        <p class="text-sm text-slate-500">No services yet. Add one using the form on the right — it'll immediately show up as an option on the fabrication job form.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100 text-slate-600 text-left">
                <th class="p-3 font-semibold">Label</th>
                <th class="p-3 font-semibold">Code</th>
                <th class="p-3 font-semibold">Jobs using it</th>
                <th class="p-3 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% services.forEach(function(s) { %>
                <tr class="hover:bg-slate-50 transition align-top">
                  <td class="p-3 font-medium text-slate-900"><%= s.label %></td>
                  <td class="p-3"><code class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs"><%= s.value %></code></td>
                  <td class="p-3 text-slate-600"><%= s.usageCount %></td>
                  <td class="p-3">
                    <div class="flex items-center justify-end gap-3">
                      <details class="relative">
                        <summary class="cursor-pointer text-blue-600 hover:underline text-xs font-semibold list-none">Edit</summary>
                        <form action="/services/<%= s.id %>/edit?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST"
                              class="absolute right-0 z-10 mt-2 w-64 bg-white border border-slate-200 rounded-xl shadow-lg p-4 space-y-3">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Label</label>
                            <input type="text" name="label" required value="<%= s.label %>"
                                   class="w-full border rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                          </div>
                          <div>
                            <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Code</label>
                            <input type="text" name="value" required value="<%= s.value %>" pattern="[A-Z0-9_]+"
                                   class="w-full border rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
                          </div>
                          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-1.5 rounded-lg text-xs font-semibold transition">
                            Save Changes
                          </button>
                        </form>
                      </details>

                      <form action="/services/<%= s.id %>/delete?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST"
                            onsubmit="return confirm('Delete the service &quot;<%= s.label %>&quot;? This cannot be undone.');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="text-red-600 hover:underline text-xs font-semibold">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Add Service Form -->
    <div class="bg-white rounded-2xl p-5 shadow border border-slate-200 self-start">
      <h2 class="text-base font-bold text-slate-800 mb-4">Add Service</h2>

      <form action="/services/new?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Service Label (Display Name)</label>
          <input
            type="text"
            name="label"
            required
            placeholder="e.g. Wood milling"
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Service Code (Value)</label>
          <input
            type="text"
            name="value"
            required
            placeholder="e.g. WOOD_MILLING"
            pattern="[A-Z0-9_]+"
            title="Only uppercase letters, numbers, and underscores are allowed."
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <p class="text-[10px] text-slate-400 mt-1">UPPERCASE letters, numbers, and underscores only. This will be stored as the database identifier.</p>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-xl text-sm font-semibold shadow-sm transition">
          Add Service
        </button>
      </form>
    </div>
  </div>
</div>
