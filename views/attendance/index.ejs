<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">My Attendance</h1>

  <!-- Current status card -->
  <div class="rounded-2xl p-5 shadow mb-6 <%= openSession ? 'bg-emerald-50 border border-emerald-300' : 'bg-white border border-slate-200' %>">
    <% if (openSession) { %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="text-sm font-semibold text-emerald-700 uppercase tracking-wide">Currently Checked In</div>
          <div class="text-lg font-bold text-emerald-900 mt-1">
            Since <%= new Date(openSession.checkInAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
          </div>
          <div class="text-xs text-emerald-600 mt-0.5" id="elapsedTimer">Calculating...</div>
        </div>
        <form action="/attendance/checkout?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" class="flex flex-col gap-2 sm:items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="notes" placeholder="End-of-day note (optional)" class="border rounded px-3 py-1.5 text-sm w-full sm:w-64">
          <button type="submit" class="bg-red-600 text-white px-5 py-2 rounded-xl font-semibold hover:bg-red-700 transition">Check Out</button>
        </form>
      </div>
      <script>
        (function() {
          const checkIn = new Date('<%= openSession.checkInAt.toISOString() %>');
          function tick() {
            const diff = Math.floor((Date.now() - checkIn) / 1000);
            const h = Math.floor(diff / 3600);
            const m = Math.floor((diff % 3600) / 60);
            const s = diff % 60;
            document.getElementById('elapsedTimer').textContent =
              `Time in: ${h}h ${m}m ${s}s`;
          }
          tick();
          setInterval(tick, 1000);
        })();
      </script>
    <% } else { %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <div class="text-sm text-slate-500">Not checked in yet today.</div>
        </div>
        <form action="/attendance/checkin?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="bg-emerald-600 text-white px-6 py-2 rounded-xl font-semibold hover:bg-emerald-700 transition">Check In</button>
        </form>
      </div>
    <% } %>
  </div>

  <!-- History table -->
  <div class="bg-white rounded-2xl shadow p-5">
    <h2 class="text-lg font-semibold mb-4">Attendance History</h2>
    <% if (records && records.length) { %>
      <div class="responsive-table">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b bg-slate-50">
              <th class="p-2 text-left">Date</th>
              <th class="p-2 text-left">Check In</th>
              <th class="p-2 text-left">Check Out</th>
              <th class="p-2 text-left">Duration</th>
              <th class="p-2 text-left">Notes</th>
            </tr>
          </thead>
          <tbody>
            <% records.forEach(r => { %>
              <tr class="border-t hover:bg-slate-50">
                <td class="p-2"><%= new Date(r.checkInAt).toLocaleDateString() %></td>
                <td class="p-2"><%= new Date(r.checkInAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></td>
                <td class="p-2">
                  <% if (r.checkOutAt) { %>
                    <%= new Date(r.checkOutAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                  <% } else { %>
                    <span class="text-emerald-600 font-medium">Active</span>
                  <% } %>
                </td>
                <td class="p-2">
                  <% if (r.durationMin != null) { %>
                    <%= Math.floor(r.durationMin / 60) %>h <%= r.durationMin % 60 %>m
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td class="p-2 text-slate-500"><%= r.notes || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-slate-500 text-sm">No attendance records yet.</p>
    <% } %>
  </div>
</div>
