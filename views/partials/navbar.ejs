<%
  // ── Navigation link order ──────────────────────────────────────────────────
  // Primary work modules first, utility/reporting modules at the end
  const navLinks = [
    { href: '/',              label: 'Dashboard' },
    { href: '/fabrication',   label: 'Fabrication' },
    { href: '/customers',     label: 'Customers' },
    { href: '/subscribers',   label: 'Subscribers' },
    { href: '/inventory',     label: 'Inventory' },
    { href: '/funds',         label: 'Funds' },
    { href: '/my-day',        label: 'Daily Log' },
    { href: '/attendance',    label: 'Attendance' },
    { href: '/work-updates',  label: 'Team Updates' },
    { href: '/assessments',   label: 'Assessments' },
    { href: '/analytics',     label: 'Analytics' }
  ];

  if (locals.currentUser && locals.currentUser.role === 'ADMIN') {
    navLinks.push(
      { href: '/attendance/admin', label: 'Attend. Admin' },
      { href: '/auth/account-logs', label: 'Account Logs' },
      { href: '/fabrication/services', label: 'Manage Services' },
      { href: '/auth/users', label: 'Manage Users' },
      { href: '/auth/change-password', label: 'Change Password' }
    );
  }
%>

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- Top bar: brand logo + user actions -->
    <div class="flex items-center justify-between gap-3 py-3">
      <a href="/" class="flex min-w-0 items-center gap-3">
        <img
          src="/public/images/triple-dimension-logo.svg"
          alt="TRIPLE DIMENSION"
          class="h-10 w-10 object-contain flex-shrink-0"
        />
        <span class="min-w-0 hidden sm:block">
          <span class="block truncate text-sm font-bold text-slate-900 sm:text-base leading-tight">TRIPLE DIMENSION</span>
          <span class="block text-xs text-slate-500 leading-tight">Workshop Management</span>
        </span>
      </a>

      <div class="hidden items-center gap-3 lg:flex">
        <% if (locals.currentUser) { %>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-600">
            <%= locals.currentUser.name %>
          </span>
          <a href="/auth/logout" class="rounded-full border border-red-200 px-3 py-1.5 text-sm text-red-600 transition hover:bg-red-50">
            Logout
          </a>
        <% } else { %>
          <a href="/auth/login" class="rounded-full border border-blue-200 px-3 py-1.5 text-sm text-blue-600 transition hover:bg-blue-50">
            Login
          </a>
        <% } %>
      </div>

      <!-- Mobile hamburger -->
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-600 transition hover:bg-slate-50 lg:hidden"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
        data-mobile-nav-toggle
      >
        <span class="sr-only">Toggle navigation</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>

    <!-- Desktop nav link row -->
    <div class="hidden items-center gap-1 overflow-x-auto pb-3 lg:flex">
      <% navLinks.forEach(function(link) { %>
        <a
          href="<%= link.href %>"
          class="whitespace-nowrap rounded-full px-3 py-1.5 text-sm transition
            <%= link.danger ? 'text-red-600 hover:bg-red-50' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>"
        >
          <%= link.label %>
        </a>
      <% }); %>
    </div>

    <!-- Mobile slide-down panel -->
    <div id="mobile-nav-panel" class="hidden border-t border-slate-200 py-3 lg:hidden" data-mobile-nav-panel>
      <% if (locals.currentUser) { %>
        <div class="mb-3 rounded-xl bg-slate-50 px-4 py-3">
          <div class="text-xs uppercase tracking-widest text-slate-400">Signed in as</div>
          <div class="mt-0.5 font-semibold text-slate-900"><%= locals.currentUser.name %></div>
        </div>
      <% } %>

      <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        <% navLinks.forEach(function(link) { %>
          <a
            href="<%= link.href %>"
            class="rounded-xl border px-4 py-3 text-sm transition
              <%= link.danger ? 'border-red-200 text-red-600 hover:bg-red-50' : 'border-slate-200 text-slate-700 hover:bg-slate-50' %>"
          >
            <%= link.label %>
          </a>
        <% }); %>
      </div>

      <div class="mt-3">
        <% if (locals.currentUser) { %>
          <a href="/auth/logout" class="block rounded-xl border border-red-200 px-4 py-3 text-center text-sm text-red-600 transition hover:bg-red-50">
            Logout
          </a>
        <% } else { %>
          <a href="/auth/login" class="block rounded-xl border border-blue-200 px-4 py-3 text-center text-sm text-blue-600 transition hover:bg-blue-50">
            Login
          </a>
        <% } %>
      </div>
    </div>

  </div>
</nav>
