<%
  // Phone/tablet-only shortcut bar fixed to the bottom of the screen.
  // Hidden on desktop (lg and up), where the full link row is shown instead.
  const path = locals.currentPath || '';
  const tabs = [
    { href: '/',            label: 'Home',      icon: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-9.5Z' },
    { href: '/fabrication', label: 'Jobs',      icon: 'M10.5 6.5a4 4 0 0 0 5.3 5.3l4.7 4.7a1.8 1.8 0 0 1-2.5 2.5l-4.7-4.7a4 4 0 0 1-5.3-5.3l2.6 2.6 2.1-.6.6-2.1-2.8-2.4Z' },
    { href: '/customers',   label: 'Customers', icon: 'M16 19v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 17.5V19M10 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm10 8v-1.5a3.5 3.5 0 0 0-2.5-3.35M15 5.15a3 3 0 0 1 0 5.7' },
    { href: '/my-day',      label: 'My Day',    icon: 'M8 3v3m8-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm4 9 2 2 4-4' }
  ];
  const isActive = (href) => href === '/' ? path === '/' : (path === href || path.startsWith(href + '/'));
%>

<nav
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-slate-200 bg-white/95 backdrop-blur lg:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
  aria-label="Shortcuts"
>
  <div class="mx-auto grid max-w-md grid-cols-4">
    <% tabs.forEach(function(tab) { const active = isActive(tab.href); %>
      <a
        href="<%= tab.href %>"
        class="flex flex-col items-center justify-center gap-1 py-2 text-[11px] font-medium transition
          <%= active ? 'text-blue-600' : 'text-slate-500 hover:text-slate-900' %>"
        <%- active ? 'aria-current="page"' : '' %>
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="<%= active ? 2.2 : 1.8 %>">
          <path stroke-linecap="round" stroke-linejoin="round" d="<%= tab.icon %>" />
        </svg>
        <span><%= tab.label %></span>
      </a>
    <% }); %>
  </div>
</nav>
<!-- Spacer so the fixed bar never covers the end of the page on phones -->
<div class="lg:hidden" style="height: calc(4rem + env(safe-area-inset-bottom));" aria-hidden="true"></div>
