<div class="max-w-2xl mx-auto bg-white p-6 rounded shadow mt-8">
  <h2 class="text-2xl font-semibold text-red-700 mb-2">System Reset</h2>
  <p class="text-sm text-gray-700 mb-6">
    This action permanently clears system records and uploaded files. This cannot be undone.
  </p>

  <% if (totalAdminsCount < 3) { %>
    <!-- Warning: not enough admins -->
    <div class="border border-amber-300 bg-amber-50 rounded-xl p-5 text-sm text-amber-950 mb-6">
      <div class="font-bold flex items-center gap-2 text-amber-800 mb-2 text-base">
        <span>⚠</span> Quorum Requirement Not Met
      </div>
      <p class="mb-3 leading-relaxed">
        To prevent accidental data loss, a system reset requires a quorum of **at least 3 unique administrators** to
        request and co-sign the action.
      </p>
      <p class="font-medium">
        Currently, there are only <span class="underline">
          <%= totalAdminsCount %>
        </span> administrator account(s) registered in the database.
      </p>
      <div class="mt-4 pt-3 border-t border-amber-200">
        <a href="/auth/register"
          class="inline-block bg-amber-600 text-white rounded-lg px-4 py-2 text-xs font-semibold hover:bg-amber-700 transition">
          Create Admin Account &rarr;
        </a>
      </div>
    </div>
    <% } else if (!activeRequest) { %>
      <!-- Start a new request -->
      <div class="border border-slate-200 bg-slate-50 rounded-xl p-5 mb-6">
        <h3 class="font-semibold text-slate-800 mb-2">Initiate Reset Authorization</h3>
        <p class="text-sm text-slate-600 mb-4 leading-relaxed">
          You have <%= totalAdminsCount %> administrators registered. You can start a reset request now.
            It will require co-signatures from 2 other unique administrators before it can be executed.
        </p>
        <form action="/auth/system-reset/request" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit"
            class="bg-red-600 text-white text-sm font-semibold rounded-xl px-5 py-2.5 hover:bg-red-700 transition">
            Start Reset Request
          </button>
        </form>
      </div>
      <% } else { %>
        <!-- Active request details -->
        <div class="border border-red-200 bg-red-50/50 rounded-xl p-5 mb-6">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-red-100">
            <div>
              <span class="text-xs uppercase tracking-wider font-semibold text-red-500">Active Request</span>
              <h3 class="font-bold text-slate-800 text-base">System Reset Quorum</h3>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
              <%= activeRequest.approvals.length %>/3 Approvals
            </span>
          </div>

          <div class="text-sm text-slate-700 mb-5 space-y-1">
            <div>Requested by: <strong>
                <%= activeRequest.requestedBy.name %>
              </strong> (<%= activeRequest.requestedBy.email %>)</div>
            <div class="text-xs text-slate-400">Created at: <%= new Date(activeRequest.createdAt).toLocaleString() %>
            </div>
          </div>

          <div class="bg-white border rounded-xl p-4 mb-5">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Signatures / Approvals</h4>
            <ul class="space-y-2">
              <% activeRequest.approvals.forEach(function(appr) { %>
                <li class="flex items-center gap-2 text-sm text-slate-800">
                  <span class="text-emerald-500">✔</span>
                  <span><strong>
                      <%= appr.admin.name %>
                    </strong> (<%= appr.admin.email %>)</span>
                  <% if (appr.adminId===activeRequest.requestedById) { %>
                    <span class="text-xs bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded">Initiator</span>
                    <% } else { %>
                      <span class="text-xs bg-blue-50 text-blue-600 px-1.5 py-0.5 rounded">Co-signed</span>
                      <% } %>
                </li>
                <% }); %>
                  <% for (let i=activeRequest.approvals.length; i < 3; i++) { %>
                    <li class="flex items-center gap-2 text-sm text-slate-400 italic">
                      <span class="text-slate-300">○</span>
                      <span>Awaiting administrator signature...</span>
                    </li>
                    <% } %>
            </ul>
          </div>

          <!-- Action panel for the current admin user -->
          <div class="flex flex-wrap gap-2 pt-2">
            <% if (!hasApproved) { %>
              <form action="/auth/system-reset/approve" method="POST" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit"
                  class="bg-emerald-600 text-white text-xs font-semibold rounded-lg px-4 py-2 hover:bg-emerald-700 transition">
                  Co-sign Reset Request
                </button>
              </form>
              <% } %>

                <% if (activeRequest.requestedById===currentAdminId) { %>
                  <form action="/auth/system-reset/cancel" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit"
                      class="bg-slate-500 text-white text-xs font-semibold rounded-lg px-4 py-2 hover:bg-slate-600 transition"
                      onclick="return confirm('Cancel this reset request?')">
                      Cancel Request
                    </button>
                  </form>
                  <% } %>
          </div>
        </div>

        <% if (activeRequest.approvals.length>= 3) { %>
          <!-- Quorum reached: execute form -->
          <div class="border border-red-500 rounded-xl p-5 bg-red-50/20">
            <h3 class="font-bold text-red-700 mb-3 text-base flex items-center gap-1.5">
              <span>🚨</span> Quorum Verified — Ready to Reset
            </h3>
            <form action="/auth/system-reset" method="POST" class="space-y-4">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <div>
                <label class="block text-sm font-medium mb-1 text-slate-800">Type confirmation phrase</label>
                <div class="text-xs text-slate-500 mb-1">Required phrase: <code><%= resetPhrase %></code></div>
                <input name="confirmationText" class="w-full border border-slate-300 px-3 py-2 rounded-xl text-sm"
                  placeholder="Type exact phrase" required />
              </div>

              <div>
                <label class="block text-sm font-medium mb-1 text-slate-800">Your Admin Password</label>
                <input name="password" type="password"
                  class="w-full border border-slate-300 px-3 py-2 rounded-xl text-sm"
                  placeholder="Confirm with your password" required />
              </div>

              <div class="flex gap-3 pt-2">
                <button type="submit"
                  class="bg-red-600 text-white px-5 py-2.5 rounded-xl hover:bg-red-700 font-semibold text-sm transition"
                  onclick="return confirm('WARNING: You are about to clear ALL operational records and user accounts in this application. Continue?')">
                  Execute Full System Reset
                </button>
              </div>
            </form>
          </div>
          <% } else { %>
            <div class="text-xs text-slate-400 italic text-center p-2">
              Execution form will become available once the quorum reaches 3 signatures.
            </div>
            <% } %>
              <% } %>

                <div class="mt-6 pt-4 border-t flex justify-end">
                  <a href="/"
                    class="border border-gray-300 px-5 py-2 rounded-xl hover:bg-gray-50 text-sm font-semibold transition">Cancel</a>
                </div>
</div>