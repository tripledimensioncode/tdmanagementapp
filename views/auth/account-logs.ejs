<div class="bg-white p-6 rounded shadow">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div>
      <h2 class="text-2xl font-semibold">Account Creation Logs</h2>
      <p class="text-sm text-gray-600">Admin audit trail for all created accounts.</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="/auth/system-reset" class="border border-red-200 text-red-600 px-3 py-2 rounded hover:bg-red-50 text-sm font-semibold transition">System Reset</a>
      <a href="/auth/register" class="border border-gray-300 px-3 py-2 rounded hover:bg-gray-50 text-sm font-semibold transition">Back to Register</a>
    </div>
  </div>

  <div class="responsive-table">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 border-b">
          <th class="p-2 text-left">Created At</th>
          <th class="p-2 text-left">Created Account</th>
          <th class="p-2 text-left">Role</th>
          <th class="p-2 text-left">Created By</th>
          <th class="p-2 text-left">IP Address</th>
          <th class="p-2 text-left">User Agent</th>
        </tr>
      </thead>
      <tbody>
        <% if (logs && logs.length) { %>
          <% logs.forEach(log => { %>
            <tr class="border-b hover:bg-gray-50">
              <td class="p-2 whitespace-nowrap"><%= log.createdAt ? log.createdAt.toISOString().replace('T',' ').slice(0,19) : '' %></td>
              <td class="p-2">
                <div class="font-medium"><%= log.createdEmail %></div>
                <div class="text-xs text-gray-500">User ID: <%= log.createdUserId %></div>
              </td>
              <td class="p-2">
                <% if (log.createdRole === 'ADMIN') { %>
                  <span class="px-2 py-1 text-xs rounded bg-purple-100 text-purple-800">ADMIN</span>
                <% } else { %>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 text-blue-800">WORKER</span>
                <% } %>
              </td>
              <td class="p-2">
                <div><%= log.createdBy ? log.createdBy.email : '-' %></div>
                <div class="text-xs text-gray-500">ID: <%= log.createdById %></div>
              </td>
              <td class="p-2 text-xs text-gray-700"><%= log.creatorIp || '-' %></td>
              <td class="p-2 text-xs text-gray-700 max-w-md break-all"><%= log.creatorUserAgent || '-' %></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="p-4 text-gray-500">No account creation logs yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
