<div class="max-w-md mx-auto bg-white p-6 rounded shadow mt-8">
  <div class="mb-6 flex flex-col items-center gap-2">
    <img
      src="/public/images/company-logo.png"
      alt="TRIPLE DIMENSION logo"
      class="h-12 w-12 object-contain error-fallback-logo"
      onerror="this.src='/public/images/triple-dimension-logo.svg'"
    />
    <div class="text-sm font-medium text-gray-600">TRIPLE DIMENSION</div>
  </div>
  <h2 class="text-2xl font-semibold mb-6">Change User Password</h2>
  <p class="text-sm text-gray-600 mb-5">
    Select any user account and enter a new password to reset their credentials.
  </p>

  <form action="/auth/change-password" method="POST" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    
    <div>
      <label class="block text-sm font-medium mb-1">Select User Account</label>
      <select name="userId" required class="w-full border border-gray-300 px-3 py-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="" disabled selected>-- Select a user --</option>
        <% users.forEach(u => { %>
          <option value="<%= u.id %>"><%= u.name %> (<%= u.email %>) — [<%= u.role %>]</option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="block text-sm font-medium mb-1">New Password</label>
      <div class="relative">
        <input name="password" id="passwordInput" type="password" required class="w-full border border-gray-300 pl-3 pr-10 py-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
        <button type="button" onclick="togglePassword('passwordInput', 'eyeIcon')" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none">
          <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </button>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium mb-1">Confirm New Password</label>
      <div class="relative">
        <input name="confirmPassword" id="confirmPasswordInput" type="password" required class="w-full border border-gray-300 pl-3 pr-10 py-2 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
        <button type="button" onclick="togglePassword('confirmPasswordInput', 'confirmEyeIcon')" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600 focus:outline-none">
          <svg id="confirmEyeIcon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </button>
      </div>
      <p id="matchError" class="text-xs text-red-500 mt-1 hidden">Passwords do not match.</p>
    </div>

    <div class="pt-2">
      <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 font-medium">Update Password</button>
    </div>
  </form>

  <script>
    function togglePassword(inputId, iconId) {
      const input = document.getElementById(inputId);
      const icon = document.getElementById(iconId);
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.024 10.024 0 013.99-4.825M9.88 9.88a3 3 0 114.24 4.24M10.73 5.085A10.16 10.16 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.4M3 3l18 18" />';
      } else {
        input.type = 'password';
        icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />';
      }
    }

    const form = document.querySelector('form');
    const pwd = document.getElementById('passwordInput');
    const cpwd = document.getElementById('confirmPasswordInput');
    const err = document.getElementById('matchError');

    form.addEventListener('submit', (e) => {
      if (pwd.value !== cpwd.value) {
        e.preventDefault();
        err.classList.remove('hidden');
      } else {
        err.classList.add('hidden');
      }
    });

    cpwd.addEventListener('input', () => {
      if (pwd.value === cpwd.value) {
        err.classList.add('hidden');
      }
    });
  </script>
</div>
