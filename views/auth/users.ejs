<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header & Actions -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 font-sans">User Management</h1>
      <p class="text-sm text-slate-500">View, register, and manage workshop user accounts.</p>
    </div>
    <div class="flex gap-2">
      <a href="/auth/register" class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 transition shadow-sm">
        + Register User
      </a>
      <a href="/auth/change-password" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
        Change Password
      </a>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="bg-white rounded-2xl shadow p-5 border border-slate-200">
    <h2 class="text-base font-bold text-slate-800 mb-4">Active User Accounts</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-100 text-slate-600 text-left font-semibold">
            <th class="p-3">Username / Name</th>
            <th class="p-3">Email Address</th>
            <th class="p-3">Role</th>
            <th class="p-3">Created Date</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% users.forEach(function(u) { %>
            <tr class="hover:bg-slate-50 transition">
              <td class="p-3 font-medium text-slate-900"><%= u.name %></td>
              <td class="p-3 text-slate-600"><%= u.email %></td>
              <td class="p-3">
                <span class="<%= u.role === 'ADMIN' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %> px-2.5 py-0.5 rounded-full text-xs font-semibold">
                  <%= u.role %>
                </span>
              </td>
              <td class="p-3 text-slate-500">
                <%= new Date(u.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="p-3 text-right">
                <% if (locals.currentUser && locals.currentUser.id !== u.id) { %>
                  <form action="/auth/users/<%= u.id %>/delete" method="POST" class="inline m-0" onsubmit="return confirm('Are you sure you want to delete/deactivate user: <%= u.name %>? This preserves all their historical data but blocks them from logging in.');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="bg-red-50 text-red-600 hover:bg-red-100 hover:text-red-700 font-semibold px-3 py-1.5 rounded-xl text-xs transition">
                      Delete
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-xs text-slate-400 italic font-medium px-3 py-1.5">Current Session</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
