<div class="bg-white p-6 rounded shadow">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-2xl font-semibold">Work Updates</h2>
    <a href="/work-updates/new" class="w-full rounded bg-blue-600 px-4 py-2 text-center text-white hover:bg-blue-700 sm:w-auto">Post Update</a>
  </div>
  <% if (items && items.length) { %>
    <div class="space-y-4">
      <% items.forEach(it=>{ %>
        <div class="border rounded p-4 hover:bg-gray-50">
          <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div class="flex-1">
              <div class="font-bold text-lg"><%= it.title %></div>
              <div class="text-xs text-gray-500">By <strong><%= it.author.name %></strong> — <%= new Date(it.createdAt).toLocaleString() %></div>
              <p class="mt-2 text-gray-700"><%= it.content %></p>
            </div>
            <div class="md:ml-4 md:whitespace-nowrap">
              <% const statusColors = { PLANNING: 'bg-yellow-100 text-yellow-800', IN_PROGRESS: 'bg-blue-100 text-blue-800', DONE: 'bg-green-100 text-green-800', BLOCKED: 'bg-red-100 text-red-800' }; %>
              <span class="<%= statusColors[it.status] %> px-3 py-1 rounded text-xs font-medium"><%= it.status.replace(/_/g, ' ') %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p class="text-gray-500">No updates yet. <a href="/work-updates/new" class="text-blue-600">Create one</a>.</p>
  <% } %>
</div>
