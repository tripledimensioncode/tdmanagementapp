<%
  const statusStyle = (status) => {
    if (status === 'ACTIVE') return 'bg-emerald-100 text-emerald-800';
    if (status === 'EXPIRED') return 'bg-amber-100 text-amber-800';
    return 'bg-red-100 text-red-800';
  };

  const allowedList = (subscriber.subscriptionType && subscriber.subscriptionType.allowedServices)
    ? subscriber.subscriptionType.allowedServices.split(/[\n,]+/).map((s) => s.trim()).filter(Boolean)
    : [];
%>

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold"><%= subscriber.name %></h1>
    <p class="text-sm text-slate-600">Workshop ID: <span class="font-semibold"><%= subscriber.code %></span></p>
  </div>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <span class="rounded-full px-2 py-1 text-xs font-semibold <%= statusStyle(subscriber.effectiveStatus) %>">
      <%= subscriber.effectiveStatus %>
    </span>
    <a href="/subscribers/<%= subscriber.id %>/card.pdf" target="_blank" rel="noopener" class="rounded bg-emerald-600 px-4 py-2 text-sm text-white hover:bg-emerald-700">Subscriber Card PDF</a>
    <% if (locals.currentUser && locals.currentUser.role === 'ADMIN') { %>
      <form action="/subscribers/<%= subscriber.id %>/toggle-status" method="POST" class="inline m-0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="rounded <%= subscriber.status === 'SUSPENDED' ? 'bg-amber-600 hover:bg-amber-700' : 'bg-slate-600 hover:bg-slate-700' %> px-4 py-2 text-sm text-white font-medium">
          <%= subscriber.status === 'SUSPENDED' ? 'Activate' : 'Deactivate' %>
        </button>
      </form>
      <form action="/subscribers/<%= subscriber.id %>/delete" method="POST" class="inline m-0" onsubmit="return confirm('Are you sure you want to permanently delete this subscriber and all their activity records?');">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="rounded bg-red-600 px-4 py-2 text-sm text-white hover:bg-red-700 font-medium">Delete</button>
      </form>
    <% } %>
    <a href="/subscribers" class="text-sm text-blue-600 hover:underline">Back to list</a>
  </div>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="bg-white p-5 shadow rounded lg:col-span-2">
    <h2 class="text-lg font-semibold mb-3">Subscriber Details</h2>
    <div class="grid grid-cols-1 gap-3 md:grid-cols-2 text-sm text-slate-700">
      <div><span class="font-semibold">Profession:</span> <%= subscriber.profession || '-' %></div>
      <div><span class="font-semibold">Student:</span> <%= subscriber.isStudent ? 'Yes' : 'No' %></div>
      <div><span class="font-semibold">Student ID:</span> <%= subscriber.studentId || '-' %></div>
      <div><span class="font-semibold">Phone (Primary):</span> <%= subscriber.phonePrimary || '-' %></div>
      <div><span class="font-semibold">Phone (Secondary):</span> <%= subscriber.phoneSecondary || '-' %></div>
      <div><span class="font-semibold">Start Date:</span> <%= subscriber.startDate ? subscriber.startDate.toISOString().split('T')[0] : '-' %></div>
      <div><span class="font-semibold">End Date:</span> <%= subscriber.endDate ? subscriber.endDate.toISOString().split('T')[0] : '-' %></div>
      <div><span class="font-semibold">Created By:</span> <%= subscriber.createdBy ? subscriber.createdBy.name : '-' %></div>
    </div>

    <% if (subscriber.notes) { %>
      <div class="mt-4 text-sm text-slate-700 whitespace-pre-wrap">
        <span class="font-semibold">Notes:</span>
        <div><%= subscriber.notes %></div>
      </div>
    <% } %>
  </div>

  <div class="bg-white p-5 shadow rounded">
    <h2 class="text-lg font-semibold mb-3">Subscription</h2>
    <% if (subscriber.subscriptionType) { %>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full px-2 py-1 text-xs font-semibold text-white" style="background-color: <%= subscriber.subscriptionType.color || '#1d4ed8' %>;">
          <span class="inline-block h-2 w-2 rounded-full bg-white/80"></span>
          <%= subscriber.subscriptionType.name %>
        </span>
      </div>
      <div class="mt-2 text-sm text-slate-700">
        <div><span class="font-semibold">Price:</span> ₵<%= Number(subscriber.subscriptionType.price).toFixed(2) %></div>
        <div><span class="font-semibold">Duration:</span> <%= subscriber.subscriptionType.durationDays %> days</div>
      </div>
      <div class="mt-3">
        <div class="text-sm font-semibold text-slate-700">Allowed Services</div>
        <% if (allowedList.length) { %>
          <ul class="mt-2 list-disc pl-5 text-sm text-slate-600">
            <% allowedList.forEach((service) => { %>
              <li><%= service %></li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-500">No services listed.</p>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-500">No subscription plan assigned.</p>
    <% } %>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="bg-white p-5 shadow rounded">
    <h2 class="text-lg font-semibold mb-3">ID Card Image</h2>
    <% if (subscriber.idCardImagePath) { %>
      <img src="<%= subscriber.idCardImagePath %>" alt="ID Card" class="w-full rounded border mb-2" />
      <a href="<%= subscriber.idCardImagePath %>" target="_blank" class="text-sm text-blue-600 hover:underline">Open image</a>
    <% } else { %>
      <p class="text-sm text-slate-500">No ID card uploaded.</p>
    <% } %>
  </div>

  <div class="bg-white p-5 shadow rounded lg:col-span-2">
    <h2 class="text-lg font-semibold mb-3">Activity Log</h2>

    <form action="/subscribers/<%= subscriber.id %>/activities?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 gap-3 md:grid-cols-4 mb-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-xs font-medium text-slate-600">Activity Type</label>
        <input type="text" name="actionType" class="w-full border rounded px-2 py-1 text-sm" placeholder="3D Print / Laser Cut" required />
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs font-medium text-slate-600">Description</label>
        <input type="text" name="description" class="w-full border rounded px-2 py-1 text-sm" placeholder="Details or materials used" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Date</label>
        <input type="date" name="serviceDate" class="w-full border rounded px-2 py-1 text-sm" value="<%= today %>" />
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600">Cost (₵)</label>
        <input type="number" step="0.01" name="cost" class="w-full border rounded px-2 py-1 text-sm" />
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs font-medium text-slate-600">Attachment (optional)</label>
        <input type="file" name="attachment" class="w-full border rounded px-2 py-1 text-sm" />
      </div>
      <div class="md:col-span-4">
        <button type="submit" class="w-full rounded bg-slate-900 px-4 py-2 text-sm text-white hover:bg-black">Record Activity</button>
      </div>
    </form>

    <% if (subscriber.activities && subscriber.activities.length) { %>
      <div class="responsive-table">
        <table class="w-full text-sm border rounded">
          <thead>
            <tr class="bg-gray-50 border-b">
              <th class="p-2 text-left">Date</th>
              <th class="p-2 text-left">Activity</th>
              <th class="p-2 text-left">Description</th>
              <th class="p-2 text-left">Cost</th>
              <th class="p-2 text-left">Logged By</th>
              <th class="p-2 text-left">Attachment</th>
            </tr>
          </thead>
          <tbody>
            <% subscriber.activities.forEach((activity) => { %>
              <tr class="border-t">
                <td class="p-2"><%= activity.serviceDate ? activity.serviceDate.toISOString().split('T')[0] : '-' %></td>
                <td class="p-2 font-medium"><%= activity.actionType %></td>
                <td class="p-2"><%= activity.description || '-' %></td>
                <td class="p-2"><%= activity.cost != null ? '₵' + Number(activity.cost).toFixed(2) : '-' %></td>
                <td class="p-2"><%= activity.createdBy ? activity.createdBy.name : '-' %></td>
                <td class="p-2">
                  <% if (activity.attachmentPath) { %>
                    <a href="<%= activity.attachmentPath %>" class="text-blue-600 hover:underline" target="_blank"><%= activity.attachmentName || 'Open' %></a>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-500">No activity recorded yet.</p>
    <% } %>
  </div>
</div>
