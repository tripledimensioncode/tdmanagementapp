<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold">Subscription Plans</h1>
    <p class="text-sm text-slate-600">Admin-only management of subscriber plan categories.</p>
  </div>
  <a href="/subscribers" class="text-sm text-blue-600 hover:underline">Back to subscribers</a>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="bg-white p-5 shadow rounded">
    <h2 class="text-lg font-semibold mb-3">Create Plan</h2>
    <form action="/subscribers/subscriptions?_csrf=<%= encodeURIComponent(csrfToken) %>" method="POST" class="space-y-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label class="block text-sm font-medium">Plan Name</label>
        <input type="text" name="name" class="w-full border rounded px-2 py-1" required />
      </div>
      <div>
        <label class="block text-sm font-medium">Price (₵)</label>
        <input type="number" step="0.01" name="price" class="w-full border rounded px-2 py-1" required />
      </div>
      <div>
        <label class="block text-sm font-medium">Duration (days)</label>
        <input type="number" name="durationDays" class="w-full border rounded px-2 py-1" required />
      </div>
      <div>
        <label class="block text-sm font-medium">Allowed Services</label>
        <textarea name="allowedServices" rows="3" class="w-full border rounded px-2 py-1" placeholder="3D printing, Laser cutting, CNC milling"></textarea>
      </div>
      <div>
        <label class="block text-sm font-medium">Color</label>
        <input type="color" name="color" value="#1d4ed8" class="h-10 w-16 border rounded" />
      </div>
      <button type="submit" class="w-full bg-slate-900 text-white px-4 py-2 rounded hover:bg-black">Save Plan</button>
    </form>
  </div>

  <div class="bg-white p-5 shadow rounded lg:col-span-2">
    <h2 class="text-lg font-semibold mb-3">Existing Plans</h2>
    <% if (types && types.length) { %>
      <div class="responsive-table">
        <table class="w-full text-sm border rounded">
          <thead>
            <tr class="bg-gray-50 border-b">
              <th class="p-2 text-left">Plan</th>
              <th class="p-2 text-left">Price</th>
              <th class="p-2 text-left">Duration</th>
              <th class="p-2 text-left">Allowed Services</th>
            </tr>
          </thead>
          <tbody>
            <% types.forEach((type) => { %>
              <tr class="border-t">
                <td class="p-2">
                  <span class="inline-flex items-center gap-2 rounded-full px-2 py-1 text-xs font-semibold text-white" style="background-color: <%= type.color || '#1d4ed8' %>;">
                    <span class="inline-block h-2 w-2 rounded-full bg-white/80"></span>
                    <%= type.name %>
                  </span>
                </td>
                <td class="p-2">₵<%= Number(type.price).toFixed(2) %></td>
                <td class="p-2"><%= type.durationDays %> days</td>
                <td class="p-2"><%= type.allowedServices || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="text-sm text-slate-500">No plans yet.</p>
    <% } %>
  </div>
</div>
