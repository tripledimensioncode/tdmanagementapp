<%
  const statusStyle = (status) => {
    if (status === 'ACTIVE') return 'bg-emerald-100 text-emerald-800';
    if (status === 'EXPIRED') return 'bg-amber-100 text-amber-800';
    return 'bg-red-100 text-red-800';
  };
%>

<div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold">Subscribers</h1>
    <p class="text-sm text-slate-600">Track workshop subscribers, their plans, and activity logs.</p>
  </div>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
    <% if (locals.currentUser && locals.currentUser.role === 'ADMIN') { %>
      <a href="/subscribers/subscriptions" class="rounded bg-slate-900 px-4 py-2 text-center text-white hover:bg-slate-800">Manage Plans</a>
    <% } %>
    <a href="/subscribers/new" class="rounded bg-blue-600 px-4 py-2 text-center text-white hover:bg-blue-700">New Subscriber</a>
  </div>
</div>

<div class="mb-4 rounded bg-white p-4 shadow">
  <form action="/subscribers" method="GET" class="flex flex-col gap-3 md:flex-row md:items-end">
    <div class="flex-1">
      <label class="block text-sm font-medium text-slate-700">Quick Search by ID</label>
      <input
        type="text"
        name="q"
        value="<%= q || '' %>"
        placeholder="Search by ID (e.g. TD-24A7)"
        class="mt-1 w-full rounded border px-3 py-2 text-sm"
      />
    </div>
    <button type="submit" class="rounded bg-slate-800 px-4 py-2 text-white hover:bg-black">Search</button>
    <% if (q) { %>
      <a href="/subscribers" class="rounded border border-slate-200 px-4 py-2 text-center text-sm text-slate-600 hover:bg-slate-50">Clear</a>
    <% } %>
  </form>
</div>

<div class="responsive-table">
  <table class="w-full bg-white shadow rounded text-sm">
    <thead>
      <tr class="border-b bg-gray-50">
        <th class="p-2 text-left">ID</th>
        <th class="p-2 text-left">Name</th>
        <th class="p-2 text-left">Subscription</th>
        <th class="p-2 text-left">Status</th>
        <th class="p-2 text-left">End Date</th>
        <th class="p-2 text-left">Created By</th>
        <th class="p-2 text-left">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (subscribers && subscribers.length) { %>
        <% subscribers.forEach((subscriber) => { %>
          <tr class="border-t hover:bg-gray-50">
            <td class="p-2 font-semibold"><%= subscriber.code %></td>
            <td class="p-2"><%= subscriber.name %></td>
            <td class="p-2">
              <% if (subscriber.subscriptionType) { %>
                <span class="inline-flex items-center gap-2 rounded-full px-2 py-1 text-xs font-semibold text-white" style="background-color: <%= subscriber.subscriptionType.color || '#1d4ed8' %>;">
                  <span class="inline-block h-2 w-2 rounded-full bg-white/80"></span>
                  <%= subscriber.subscriptionType.name %>
                </span>
              <% } else { %>
                -
              <% } %>
            </td>
            <td class="p-2">
              <span class="rounded-full px-2 py-1 text-xs font-semibold <%= statusStyle(subscriber.effectiveStatus) %>">
                <%= subscriber.effectiveStatus %>
              </span>
            </td>
            <td class="p-2"><%= subscriber.endDate ? subscriber.endDate.toISOString().split('T')[0] : '-' %></td>
            <td class="p-2"><%= subscriber.createdBy ? subscriber.createdBy.name : '-' %></td>
            <td class="p-2 whitespace-nowrap">
              <a href="/subscribers/<%= subscriber.id %>" class="text-blue-600 hover:underline">View</a>
              <span class="text-gray-300 mx-1">|</span>
              <a href="/subscribers/<%= subscriber.id %>/card.pdf" target="_blank" rel="noopener" class="text-emerald-700 hover:underline">Card PDF</a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="7" class="p-4 text-gray-500">No subscribers found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
