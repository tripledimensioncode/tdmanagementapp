{
  "name": "triple-dimension",
  "version": "1.0.0",
  "description": "Internal TRIPLE DIMENSION intranet (Node + Express + EJS + PostgreSQL/Prisma, hosted entirely on Vercel — no Telegram bot, no Raspberry Pi hosting, no local NAS storage)",
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "vercel-build": "prisma generate",
    "bootstrap": "node scripts/bootstrap.js",
    "backup": "node scripts/backup.js backup",
    "restore": "node scripts/backup.js restore",
    "start": "node server.js",
    "dev": "nodemon --watch . --exec node server.js",
    "setup:prod": "npm run bootstrap && prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:consolidate-migrations": "node scripts/consolidate-prisma-migrations.js",
    "seed": "node scripts/seed.js"
  },
  "author": "TRIPLE DIMENSION",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^4.14.0",
    "@vercel/blob": "^2.8.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "connect-redis": "^10.0.0",
    "dayjs": "^1.11.9",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^4.14.0"
  }
}
