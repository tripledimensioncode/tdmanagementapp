# Core Settings
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000

# Central Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Secret
SESSION_SECRET="long_cryptographically_secure_random_session_secret_32bytes"

# Private File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Session & Rate Limiting (Optional Redis — falls back to in-memory locally when unset)
# REDIS_URL="rediss://default:password@sample-redis.upstash.io:6379"
SESSION_MAX_AGE_HOURS=8

# Production SSL & Proxy
COOKIE_SECURE=0
TRUST_PROXY=0
